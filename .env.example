# CloudPulse Environment Configuration

# Application
APP_NAME=CloudPulse
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=cloudpulse-enterprise-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL for Production, SQLite supported out-of-the-box for local dev)
# For local SQLite: sqlite:///./cloudpulse.db
# For Docker / PostgreSQL: postgresql://postgres:postgres@localhost:5432/cloudpulse
DATABASE_URL=sqlite:///./cloudpulse.db

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Monitoring & Alert Engine Defaults
DEFAULT_HEARTBEAT_TIMEOUT_SECONDS=30
CPU_WARNING_THRESHOLD=80.0
CPU_CRITICAL_THRESHOLD=90.0
RAM_WARNING_THRESHOLD=85.0
RAM_CRITICAL_THRESHOLD=95.0
DISK_WARNING_THRESHOLD=85.0
DISK_CRITICAL_THRESHOLD=95.0

# Optional AWS CloudWatch Integration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
ENABLE_AWS_CLOUDWATCH=False
